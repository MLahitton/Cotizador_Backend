{
  "Authentication": {
    "Google": {
      "ClientId": "local-dev-google-client-id"
    },
    "Jwt": {
      "Issuer": "https://issuer.local",
      "Audience": "cotizador-audience",
      "SigningKey": "local-dev-signing-key-at-least-32-bytes-01",
      "AccessTokenMinutes": "120"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=SnG;Username=postgres;Password=postgres"
  },
  "FileStorage": {
    "RootPath": "App_Data/storage"
  },
  "CotizadorAi": {
    "BaseUrl": "http://127.0.0.1:8001",
    "TimeoutSeconds": 30,
    "MaximumResponseBytes": 33554432,
    "MaximumPageCount": 100
  },
  "DocumentProcessingWorker": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
