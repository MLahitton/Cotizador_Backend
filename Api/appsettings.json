{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FileStorage": {
    "RootPath": "App_Data/storage"
  },
  "CotizadorAi": {
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 30,
    "MaximumResponseBytes": 33554432,
    "MaximumPageCount": 100
  },
  "DocumentProcessingWorker": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
