{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    },
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "SigningKey": "",
      "AccessTokenMinutes": "120"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "CotizadorAi2": {
    "BaseUrl": "http://127.0.0.1:8000",
    "SimilarityEndpoint": "http://127.0.0.1:8000/similarity/evaluate",
    "TimeoutSeconds": 600,
    "MaximumResponseBytes": 33554432,
    "Enabled": true
  },
  "DocumentProcessing": {
    "Provider": "AI2",
    "EnableLegacyFallback": false
  }
}
